{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Waitlight (fake sessions)",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "env": {
        "WAITLIGHT_SESSIONS_DIR": "${workspaceFolder}/.dev-sessions"
      },
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "npm: watch"
    }
  ]
}
